{
  "name": "Hister",
  "short_name": "Hister",
  "description": "Your own search engine for the pages you visit and the files you keep.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
